# Server
HOST=0.0.0.0
PORT=1337
APP_KEYS=your-app-key-1,your-app-key-2

# Secrets
API_TOKEN_SALT=your-api-token-salt
ADMIN_JWT_SECRET=your-admin-jwt-secret
TRANSFER_TOKEN_SALT=your-transfer-token-salt
JWT_SECRET=your-jwt-secret
ENCRYPTION_KEY=your-encryption-key

# Database
# ------------------------------------------------------------------
# Choose ONE of the two setups below (config/database.ts auto-detects
# which one to use based on whether DATABASE_URL is set).
# ------------------------------------------------------------------

# Option A — Neon (or any managed/cloud Postgres):
# Uncomment and fill in with your Neon connection string.
# Use the "pooled" connection string from the Neon dashboard for
# normal app traffic (recommended), and keep sslmode=require.
# DATABASE_URL=postgresql://neondb_owner:your-password@ep-example-12345-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# (SSL is enabled automatically when DATABASE_URL is set — no extra flags needed.
#  Only set these if you hit a self-signed certificate error with your provider's pooler:)
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Option B — Local Postgres (e.g. the `fomico-postgres` Docker service).
# Leave DATABASE_URL empty/commented above and use these instead —
# these values already match docker-compose.yml's defaults.
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi

# Email (configure with your provider)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Cloudinary (optional)
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
