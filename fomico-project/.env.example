# Root environment file for docker-compose.yml
# Copy this to .env and fill in real values: cp .env.example .env

# --- Database ---
# Leave DATABASE_URL empty to use the bundled local `fomico-postgres` container
# (in that case DB_PASSWORD sets that container's password too).
#
# To use Neon instead, set DATABASE_URL to your Neon connection string
# (get it from the Neon dashboard — use the "pooled connection" string):
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=
DB_PASSWORD=strapi

# --- Strapi secrets ---
# Generate real random values for all of these before going to production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=your-jwt-secret
ADMIN_JWT_SECRET=your-admin-jwt-secret
API_TOKEN_SALT=your-api-token-salt
TRANSFER_TOKEN_SALT=your-transfer-token-salt
ENCRYPTION_KEY=your-encryption-key
# 4 comma-separated random keys, no spaces:
APP_KEYS=key1,key2,key3,key4

# --- Frontend ---
# API token created in Strapi admin (Settings > API Tokens) with read access,
# used by the Next.js frontend to fetch content from Strapi.
STRAPI_API_TOKEN=
